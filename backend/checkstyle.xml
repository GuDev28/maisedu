<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Regras de estilo do back-end do MaisEdu (Checkstyle).

    Subconjunto de regras escolhido pelo grupo: imports, nomes, chaves, tamanho de linha,
    espaçamento e algumas boas práticas. Vale para src/main e src/test.

    Rodar localmente (pasta backend):  ./mvnw checkstyle:check
    Toda violação reprova o build (severity=error aqui e violationSeverity=warning no pom.xml).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- ===== Arquivo ===== -->

    <!-- Indentação só com espaços (o padrão do grupo é 4 espaços), nunca com TAB -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Todo arquivo termina com quebra de linha -->
    <module name="NewlineAtEndOfFile"/>

    <!-- Sem espaços sobrando no fim da linha -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Linha com espaços em branco no final."/>
    </module>

    <!-- Linhas de no máximo 120 caracteres (exceto package, import e URLs) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*|https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- ===== Imports ===== -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport"/>

        <!-- ===== Nomes ===== -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <!-- camelCase; nos testes, aceita o padrão metodo_cenario_resultadoEsperado -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
        </module>
        <!-- Constantes em MAIÚSCULAS_COM_UNDERLINE; "log" é a exceção usual do SLF4J -->
        <module name="ConstantName">
            <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="StaticVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="CatchParameterName"/>
        <module name="PatternVariableName"/>
        <module name="RecordComponentName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>

        <!-- ===== Chaves ===== -->
        <!-- if/else/for/while/do sempre com chaves, mesmo com uma linha só -->
        <module name="NeedBraces"/>
        <!-- "{" no fim da linha e "}" na mesma linha do else/catch/finally -->
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyCatchBlock"/>

        <!-- ===== Espaçamento ===== -->
        <!-- Espaço depois de vírgula, ponto e vírgula, cast e palavras-chave (if, for, catch...) -->
        <module name="WhitespaceAfter"/>
        <!-- Espaço em volta de operadores, "->" e chaves. Blocos vazios ({}) são permitidos -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptyCatches" value="true"/>
            <property name="allowEmptySwitchBlockStatements" value="true"/>
        </module>

        <!-- ===== Boas práticas ===== -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="EmptyStatement"/>
        <module name="ModifierOrder"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
    </module>
</module>
