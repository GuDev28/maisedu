# Copie para .env (na pasta backend/) e preencha. O Spring lê este arquivo automaticamente.

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/maisedu
DB_USERNAME=postgres
DB_PASSWORD=

# Segredo do JWT: pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=
# true em produção (HTTPS)
JWT_COOKIE_SECURE=false

# Resend: sem domínio verificado, o remetente onboarding@resend.dev só entrega para o
# e-mail dono da conta no Resend. Para enviar a qualquer professor, verifique um domínio em
# https://resend.com/domains e use um remetente desse domínio.
RESEND_API_KEY=
RESEND_REMETENTE=MaisEdu <onboarding@resend.dev>

# Origens autorizadas por CORS (só se o front chamar a API em outra origem, sem proxy)
CORS_ORIGENS=http://localhost:5173

# Perfil de demonstração: o perfil não é lido deste arquivo. Ative-o ao rodar:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
# ou, no IntelliJ, em Run Configuration > Active profiles: dev
