digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.9, fontname="Helvetica", fontsize=20, labelloc=t, label=<<b>MaisEdu — modelo de dados (PostgreSQL, migrations V1 a V10)</b><br/><font point-size="12">🔑 chave primária · → chave estrangeira · * obrigatório · gerado a partir do banco criado pelas migrations</font>>, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [color="#64748b", arrowhead=crow, arrowtail=none, penwidth=1.1];
