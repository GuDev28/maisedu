digraph Arquitetura {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.5, ranksep=0.8,
         label=<<b>MaisEdu — arquitetura</b><br/><font point-size="12">docker compose up --build: três contêineres; navegador e API na mesma origem (cookie HttpOnly, SameSite=Strict, sem CORS)</font>>];
  node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", fillcolor="white", color="#94a3b8", margin="0.2,0.12"];
  edge [fontname="Helvetica", fontsize=10.5, color="#475569"];

  navegador [label=<<b>Navegador</b><br/><font point-size="10">admin · professor · aluno</font>>, fillcolor="#f1f5f9"];

  subgraph cluster_compose {
    label=<<b>Docker Compose</b>>; fontsize=14; style="rounded,dashed"; color="#64748b";

    subgraph cluster_front {
      label=<<b>frontend</b> (nginx 1.27) · porta 8081>; fontsize=12; style="rounded,filled"; fillcolor="#e6f4f1"; color="#99d5cc";
      spa [label=<<b>SPA React 19 + Vite</b><br/><font point-size="10">React Router · Bootstrap 5.3<br/>menu lateral por perfil</font>>];
      proxy [label=<<b>Proxy /api</b><br/><font point-size="10">/api/* → backend:8080/*<br/>demais rotas → index.html</font>>];
    }

    subgraph cluster_back {
      label=<<b>backend</b> (Spring Boot 4 · Java 25) · porta 8080>; fontsize=12; style="rounded,filled"; fillcolor="#e0e7ff"; color="#a5b4fc";
      seguranca [label=<<b>Spring Security</b><br/><font point-size="10">filtro JWT do cookie · RBAC<br/>confere conta e sessão no banco</font>>];
      controllers [label=<<b>Controllers REST</b>>];
      services [label=<<b>Services</b><br/><font point-size="10">regras RN01–RN06 · AcessoTurma<br/>auditoria · LGPD</font>>];
      motor [label=<<b>MotorAdaptativo</b><br/><font point-size="10">classe pura (RN06)</font>>, fillcolor="#fef3c7"];
      repos [label=<<b>Repositories</b><br/><font point-size="10">Spring Data JPA / Hibernate</font>>];
    }

    db [label=<<b>db</b><br/>PostgreSQL 17<br/><font point-size="10">esquema só por Flyway (V1–V9)<br/>trigger RN04 · CHECKs · EXCLUDE</font>>, shape=cylinder, fillcolor="#fce7f3", color="#f9a8d4"];
  }

  resend [label=<<b>Resend</b><br/><font point-size="10">e-mail da senha provisória<br/>(enviado depois do commit)</font>>, fillcolor="#f1f5f9"];

  navegador -> spa [label="HTTP :8081"];
  spa -> proxy [label="fetch /api"];
  proxy -> seguranca [label="HTTP interno"];
  seguranca -> controllers -> services -> repos;
  services -> motor [arrowhead=none, style=dashed];
  repos -> db [label="JDBC"];
  services -> resend [label="HTTPS", style=dashed];
}
