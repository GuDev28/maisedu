# Variáveis do docker compose (copie para .env na raiz do projeto).

DB_PASSWORD=maisedu

# Segredo do JWT: pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=

# true quando estiver atrás de HTTPS
JWT_COOKIE_SECURE=false

# Resend: sem domínio verificado, onboarding@resend.dev só entrega para o e-mail dono da conta Resend.
RESEND_API_KEY=
RESEND_REMETENTE=MaisEdu <onboarding@resend.dev>

# Endereço do sistema nos links dos e-mails (troque pelo domínio quando publicar)
APP_URL=http://localhost:8081

# "dev" cria o cenário de demonstração num banco vazio (duas escolas fictícias com 1000 alunos simulados;
# leva cerca de 30 s na primeira subida); use "prod" para o comportamento de produção
# (só a instituição e o admin iniciais, com senha provisória no log).
SPRING_PROFILES_ACTIVE=dev

# Fuso horário dos prazos de entrega e das datas da plataforma
TZ=America/Sao_Paulo
